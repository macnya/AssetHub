# AssetHub — backend/.env
#
# Copy to backend/.env and fill in. Never commit the filled version; .gitignore
# already covers it.
#
# This file exists because the original repository had none, and the only
# record of which variables were needed was the code that read them.

# --- Database -----------------------------------------------------------
# Point at the AssetHub Supabase project, NOT VisionFund's.
#
# Two connection strings matter and they are not interchangeable:
#   port 5432 — direct. Session settings persist. Limited connections.
#   port 6543 — pooler, transaction mode. SET does not survive between
#               statements, so app.org_id must be set with the LOCAL form
#               inside a transaction. See docs/going-multi-tenant.md.
DATABASE_URL=postgresql://app_user:PASSWORD@HOST:5432/postgres

# Migrations only. This role may own tables and bypass row-level security,
# which is exactly why the API must not use it.
MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Auth ---------------------------------------------------------------
# Long and random. Changing it signs everyone out immediately, because
# verifyToken compares the token's iat against password_changed_at.
JWT_SECRET=

# --- Assistant ----------------------------------------------------------
# Billed per call. Watch org_usage before opening self-serve sign-up.
GROQ_API_KEY=

# --- Service-to-service --------------------------------------------------
# Used by /auth/service-token for the chat bot integration.
BOT_SERVICE_SECRET=

# --- Server -------------------------------------------------------------
PORT=5000
